# Copy this file to server/.env and replace the placeholder values.
# Never commit server/.env or real credentials.

# --- Core ---
NODE_ENV=development
PORT=4000

# SQLite for local development (resolved relative to server/prisma).
# For production options and the untested PostgreSQL path, see
# docs/DEPLOYMENT.md (Database).
DATABASE_URL="file:./dev.db"

# Public URL of the web app (used in verification / reset links).
APP_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Security ---
# REQUIRED in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=7

# Sessions use SameSite=Lax, so the client and API must share a site.
# The supported topology is a single origin (Express also serving
# client/dist). Set this to true when serving over HTTPS; production
# forces secure cookies regardless of this value.
COOKIE_SECURE=false

# --- Uploads (portfolio / avatar images) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Optional ---
# Absolute or server-relative path to the built client. Defaults to
# ../client/dist when omitted; only used if that directory exists.
# CLIENT_DIST=../client/dist

# --- Seed data ---
# The seed script creates this administrator. Change the password before
# exposing the app to anyone.
ADMIN_EMAIL=admin@ayosdito.test
ADMIN_PASSWORD=Admin123!demo
ADMIN_NAME="AyosDito Admin"

# Demo marketplace content (providers, requests, reviews). Set to false
# before running the seed against a production database.
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo1234!

# --- Optional SMTP (verification and password reset email) ---
# Without these values, emails are NOT sent. In development the links are
# printed to the API console and returned in the response for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AyosDito <no-reply@localhost>"
