// AyosDito data model.
//
// Status fields are strings (not native enums) so the same schema works on
// SQLite for local development and PostgreSQL for deployment. Allowed values
// are enforced by the shared Zod contracts and application logic.
//
// Money is stored as INTEGER CENTAVOS to avoid floating point rounding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique
  passwordHash    String
  role            String    @default("CUSTOMER") // CUSTOMER | PROVIDER | ADMIN
  accountStatus   String    @default("ACTIVE") // ACTIVE | SUSPENDED
  emailVerifiedAt DateTime?
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customerProfile      CustomerProfile?
  providerProfile      ProviderProfile?
  sessions             Session[]
  emailTokens          EmailToken[]
  passwordResetTokens  PasswordResetToken[]
  favorites            Favorite[]
  requests             ServiceRequest[]       @relation("RequestCustomer")
  reviews              Review[]               @relation("ReviewAuthor")
  reportsFiled         Report[]               @relation("ReportReporter")
  reportsReviewed      Report[]               @relation("ReportReviewer")
  verificationsReviewed ProviderVerification[] @relation("VerificationReviewer")
  auditLogs            AuditLog[]

  @@index([role])
  @@index([accountStatus])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String    @default("VERIFY_EMAIL")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredLocationId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLocation Location? @relation("PreferredLocation", fields: [preferredLocationId], references: [id], onDelete: SetNull)
}

model ProviderProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  businessName       String
  description        String    @default("")
  profileImage       String?
  yearsOfExperience  Int?
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED | IDENTITY_VERIFIED | BUSINESS_VERIFIED
  verificationRank   Int       @default(0)
  approvalStatus     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason    String?
  identityVerifiedAt DateTime?
  businessVerifiedAt DateTime?
  approvedAt         DateTime?
  ratingAvg          Float     @default(0)
  reviewCount        Int       @default(0)
  ratingScore        Float     @default(0)
  minStartingPrice   Int?
  isDemo             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings         ServiceListing[]
  serviceAreas     ProviderServiceArea[]
  portfolioImages  PortfolioImage[]
  quotes           Quote[]
  targetedRequests ServiceRequest[]     @relation("RequestTargetProvider")
  assignedRequests ServiceRequest[]     @relation("RequestAssignedProvider")
  reviews          Review[]
  favorites        Favorite[]
  verifications    ProviderVerification[]

  @@index([approvalStatus, verificationRank])
  @@index([ratingScore])
  @@index([minStartingPrice])
  @@index([businessName])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String   @default("wrench")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings ServiceListing[]
  requests ServiceRequest[]

  @@index([isActive, sortOrder])
}

model ServiceListing {
  id                 String   @id @default(cuid())
  providerId         String
  categoryId         String
  title              String
  description        String?
  startingPrice      Int // centavos
  diagnosticFee      Int? // centavos
  priceType          String   @default("STARTING_FROM") // STARTING_FROM | ESTIMATE | FIXED
  requiresInspection Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([providerId, isActive])
  @@index([categoryId, isActive])
  @@index([startingPrice])
}

model Location {
  id               String   @id @default(cuid())
  name             String
  locationType     String // REGION | PROVINCE | CITY | BARANGAY
  parentLocationId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent             Location?             @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict)
  children           Location[]            @relation("LocationHierarchy")
  preferredBy        CustomerProfile[]     @relation("PreferredLocation")
  serviceAreas       ProviderServiceArea[]
  requests           ServiceRequest[]

  @@index([parentLocationId])
  @@index([locationType, isActive])
}

model ProviderServiceArea {
  id         String @id @default(cuid())
  providerId String
  locationId String

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([providerId, locationId])
  @@index([locationId])
}

model ServiceRequest {
  id                  String    @id @default(cuid())
  customerId          String
  categoryId          String
  title               String
  problemDescription  String
  locationId          String
  preferredSchedule   String?
  status              String    @default("PENDING") // PENDING | RESPONDED | ACCEPTED | IN_PROGRESS | COMPLETED | CANCELLED | DECLINED
  targetProviderId    String?
  assignedProviderId  String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer         User              @relation("RequestCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  targetProvider   ProviderProfile?  @relation("RequestTargetProvider", fields: [targetProviderId], references: [id], onDelete: SetNull)
  assignedProvider ProviderProfile?  @relation("RequestAssignedProvider", fields: [assignedProviderId], references: [id], onDelete: SetNull)
  quotes           Quote[]
  review           Review?

  @@index([customerId, status])
  @@index([status, categoryId])
  @@index([assignedProviderId, status])
  @@index([targetProviderId])
  @@index([locationId])
}

model Quote {
  id               String   @id @default(cuid())
  serviceRequestId String
  providerId       String
  proposedPrice    Int // centavos
  priceNotes       String?
  estimatedDuration String?
  status           String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, providerId])
  @@index([providerId, status])
}

model Review {
  id                 String    @id @default(cuid())
  serviceRequestId   String    @unique
  customerId         String
  providerId         String
  rating             Int
  comment            String?
  moderationStatus   String    @default("VISIBLE") // VISIBLE | HIDDEN
  providerResponse   String?
  providerRespondedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  customer       User            @relation("ReviewAuthor", fields: [customerId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, moderationStatus])
  @@index([customerId])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  providerId String
  createdAt  DateTime @default(now())

  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([customerId, providerId])
  @@index([providerId])
}

model PortfolioImage {
  id         String   @id @default(cuid())
  providerId String
  imageUrl   String
  caption    String?
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model Report {
  id                  String    @id @default(cuid())
  reporterId          String
  reportedEntityType  String // PROVIDER | REVIEW
  reportedEntityId    String
  reason              String
  description         String
  status              String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolutionNote      String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedEntityType, reportedEntityId])
  @@index([reporterId])
}

model ProviderVerification {
  id               String    @id @default(cuid())
  providerId       String
  verificationType String // IDENTITY | BUSINESS
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note             String
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([providerId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String? // JSON string
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}
